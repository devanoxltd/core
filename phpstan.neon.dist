includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
    level: max
    paths:
        - app
        - config
        - database
        - routes
    tmpDir: build/phpstan
    ignoreErrors:
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/tenancy.php
        -
            identifier: trait.unused
            path: app/Traits/Models/TenantConnection.php
